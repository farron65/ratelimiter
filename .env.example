ALGORITHM=token_bucket

# --- token bucket ---
MAX_TOKENS=10
REFILL_RATE=0.5

AUTH_MAX_TOKENS=5
AUTH_REFILL_RATE=0.01

# --- sliding window ---
WINDOW_SIZE=60
LIMIT=10

AUTH_WINDOW_SIZE=60
AUTH_LIMIT=5

# --- shared ---
BACKEND_URL=http://localhost:9000
REDIS_ADDR=localhost:6379

PORT=10000

AUTH_PATHS=/login,/signup,/auth/refresh,/forgot-password,/reset-password